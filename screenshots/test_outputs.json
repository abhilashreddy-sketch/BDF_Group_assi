  "test_3_update_hall_immutability": {
    "description": "Test 3: Update first hall sending custom code -> Expected HTTP 200, code remains HAL-0001",
    "request": {
      "method": "PUT",
      "endpoint": "/halls/1",
      "body": {
        "name": "Updated Main Seminar Hall",
        "building": "Block C",
        "code": "CUSTOM-999"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "id": 1,
        "code": "HAL-0001",
        "name": "Updated Main Seminar Hall",
        "building": "Block C",
        "created_at": "2026-11-14T13:33:43.805Z",
        "updated_at": "2026-11-14T13:33:43.843Z"
      }
    },
    "passed": true
  },
  "booking_conflict_test": {
    "description": "Duplicate booking prevention -> Expected HTTP 409 Conflict",
    "request": {
      "method": "POST",
      "endpoint": "/bookings",
      "body": {
        "organiser_id": 1,
        "hall_id": 1,
        "booking_date": "2026-11-20"
      }
    },
    "response": {
      "status": 409,
      "body": {
        "error": "Hall is already booked for this date"
      }
    },
    "passed": true
  },
